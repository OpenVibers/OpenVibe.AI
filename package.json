{
  "name": "openvibe-ai",
  "version": "0.1.0",
  "private": true,
  "description": "OpenVibe.AI: providers, models, routing profiles, versioned prompt templates and workflows, runs, request logs, citations, scoped cache, quotas and audit for every OpenVibe product. Extracted from OpenVibe.Live's AI subsystem.",
  "main": "server/index.js",
  "bin": {
    "openvibe-exchange-mcp": "bin/openvibe-exchange-mcp.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node server/index.js",
    "mcp:exchange": "node bin/openvibe-exchange-mcp.js",
    "test": "node test/run.js",
    "test:pg": "AI_TEST_STORE=pg node test/run.js"
  },
  "keywords": [
    "openvibe",
    "ai",
    "llm",
    "workflows",
    "whisper"
  ],
  "author": "OpenVibers",
  "license": "AGPL-3.0-only",
  "repository": "github:OpenVibers/OpenVibe.AI",
  "dependencies": {
    "ajv": "^8.17.1",
    "axe-core": "^4.10.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "iovalkey": "^0.4.0",
    "openvibe-contracts": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.contracts/archive/v0.443.0.tar.gz",
    "openvibe-sdk": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.sdk/archive/v0.187.0.tar.gz",
    "openvibe-shared": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.shared/archive/v4.313.0.tar.gz",
    "openvibe-shared": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.shared/archive/v4.313.0.tar.gz",
    "pg": "^8.23.0",
    "playwright-core": "^1.55.0"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
